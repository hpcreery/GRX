{
  "name": "@grx/viewer",
  "version": "4.4.0",
  "description": "GPU-Accelerated Web Based EDA Manufacturing Artwork Viewer",
  "main": "./out/electron/main/index.js",
  "author": "Hunter Creery",
  "homepage": "https://grx.electronicloud.app",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.web.json --composite false --watch",
    "start": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "dev:web": "vite",
    "dev:desktop": "electron-vite dev",
    "build:web": "vite build",
    "build:electron": "electron-vite build",
    "build:icons": "electron-icon-builder --input=resources/icon.png --output=resources --flatten",
    "build:win": "npm run build:electron && electron-builder --win --config",
    "build:mac": "npm run build:electron && electron-builder --mac --config",
    "build:linux": "npm run build:electron && electron-builder --linux --config",
    "build:desktop": "npm run build:electron && electron-builder --win --mac --linux --config",
    "dev": "npm run dev:web",
    "build": "npm run build:web"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@grx/artwork-format": "workspace:*",
    "@grx/engine": "workspace:*",
    "@mantine/carousel": "^9.5.1",
    "@mantine/code-highlight": "^9.5.1",
    "@mantine/core": "^9.5.1",
    "@mantine/dropzone": "^9.5.1",
    "@mantine/form": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/modals": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@mantine/nprogress": "^9.5.1",
    "@mantine/spotlight": "^9.5.1",
    "@mantine/store": "^9.5.1",
    "@react-hook/resize-observer": "^2.0.2",
    "@react-spring/web": "^10.1.2",
    "@tabler/icons-react": "^3.46.0",
    "@types/react": "^19.2.18",
    "@use-gesture/react": "^10.3.1",
    "chroma-js": "^3.2.0",
    "comlink": "^4.4.2",
    "gl-matrix": "^3.4.4",
    "mantine-contextmenu": "^9.4.0",
    "re-resizable": "^6.11.2",
    "react": "^19.2.8",
    "typescript-event-target": "^1.1.2",
    "web-vitals": "^6.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/notarize": "^3.1.1",
    "@grx/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/chroma-js": "^3.1.2",
    "@types/earcut": "^3.0.0",
    "@types/ndarray": "^1.0.14",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "electron": "^41.10.4",
    "electron-builder": "26.0.20",
    "electron-updater": "^6.8.3",
    "electron-vite": "^5.0.0",
    "react-dom": "^19.2.8",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  }
}
