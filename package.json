{
  "name": "grx-turborepo",
  "version": "4.4.0",
  "description": "GPU-Accelerated Web Based EDA Manufacturing Artwork Viewer",
  "author": "Hunter Creery",
  "homepage": "https://github.com/hpcreery/GRX/blob/master/README.md",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "turbo watch dev",
    "dev:desktop": "turbo watch dev:desktop",
    "build": "turbo run build",
    "build:desktop": "turbo run build:desktop",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "typecheck": "turbo run typecheck",
    "changelog": "git-cliff --config cliff.toml --latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.1",
    "commitlint": "^20.4.2",
    "git-cliff": "^2.12.0",
    "husky": "^9.1.7",
    "npm-check-updates": "^22.1.1",
    "turbo": "2.10.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
