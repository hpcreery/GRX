{
  "name": "grx-turborepo",
  "version": "4.4.4",
  "description": "GPU-Accelerated Web Based EDA Manufacturing Artwork Viewer",
  "author": "Hunter Creery",
  "homepage": "https://github.com/hpcreery/GRX/blob/master/README.md",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "turbo watch dev",
    "dev:desktop": "turbo watch dev:desktop",
    "test": "turbo run test",
    "build": "turbo run build",
    "build:desktop": "turbo run build:desktop",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "typecheck": "turbo run typecheck",
    "changelog": "git-cliff --config cliff.toml --latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.1",
    "commitlint": "^20.4.2",
    "git-cliff": "^2.12.0",
    "husky": "^9.1.7",
    "npm-check-updates": "^22.1.1",
    "turbo": "2.10.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
