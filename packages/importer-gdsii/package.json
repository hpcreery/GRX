{
  "name": "@grx/importer-gdsii",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist/**",
    "dist"
  ],
  "exports": {
    "./converter": "./dist/converter.mjs",
    "./gdsii_records": "./dist/gdsii_records.mjs",
    "./gdsii_tree": "./dist/gdsii_tree.mjs",
    "./lexer": "./dist/lexer.mjs",
    "./messages": "./dist/messages.mjs",
    "./parser": "./dist/parser.mjs",
    "./plotter": "./dist/plotter.mjs",
    "./types": "./dist/types.mjs",
    "./utils": "./dist/utils.mjs",
    "./*": "./*"
