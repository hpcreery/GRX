  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@grx/artwork-format": "workspace:*",
    "gl-matrix": "^3.4.4"
  },
  "devDependencies": {
    "@grx/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
