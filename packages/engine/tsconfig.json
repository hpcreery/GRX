{
  "extends": "@grx/typescript-config/vite.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "types": [
      "vite-plugin-glsl/ext",
      "vite-plugin-arraybuffer/types"
    ],
    "paths": {
      "@grx/engine/*": [
        "./src/*"
      ]
    }
  },
  "include": ["src"],
  "exclude": [
    "**/node_modules/**/*",
    "dist",
    "**/*.test.ts"
  ]
}
